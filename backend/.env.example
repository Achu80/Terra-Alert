FLASK_ENV=development
FLASK_DEBUG=True

# Development Mode (set to true to use mock data - faster development)
DEV_MODE=true

# Google Earth Engine
# Run 'earthengine authenticate' to set up GEE credentials
# Run 'earthengine set_project YOUR_PROJECT_ID' to register project
GEE_PROJECT_ID=your-project-id-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
