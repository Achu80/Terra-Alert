FLASK_ENV=development
FLASK_DEBUG=True

# Development Mode (set to true to use mock data - faster development)
DEV_MODE=true

# Google Earth Engine
# Run 'earthengine authenticate' to set up GEE credentials
# Run 'earthengine set_project YOUR_PROJECT_ID' to register project
GEE_PROJECT_ID=your-project-id-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# OpenWeatherMap (7-day rainfall forecast) - https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your-openweather-key-here

# Google Gemini (AI assistant)
GEMINI_API_KEY=your-gemini-key-here

# Admin mode PIN for the mobile app (choose 6+ digits)
ADMIN_PIN=change-me


# Twilio SMS alerts (optional - see docs/TWILIO_SMS_SETUP.md)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Admin/test number (used by test_twilio.py, and as a fallback if the database is down)
ALERT_PHONE_NUMBER=+91xxxxxxxxxx
# Only text for risk scores at or above this (60 = HIGH, 80 = CRITICAL)
SMS_MIN_SCORE=60
# Don't text the same person about the same place again within this many hours
SMS_COOLDOWN_HOURS=6
# Text subscribers whose saved place is within this many km of the risky place
SMS_RADIUS_KM=10
