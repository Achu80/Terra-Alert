# Flask backend. On a physical phone, "localhost" is the phone itself —
# use your computer's LAN IP (run `ipconfig`) and start Flask with host=0.0.0.0.
# Android emulator: http://10.0.2.2:5000/api
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api

# Supabase (same project as the web frontend)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
