{
  "expo": {
    "name": "Terra Alert",
    "slug": "terra-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.terraalert.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.terraalert.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Terra Alert uses your location to show landslide risk near you."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Terra Alert uses the microphone so you can ask the assistant questions by voice.",
          "speechRecognitionPermission": "Terra Alert uses speech recognition to turn your voice into a message for the assistant.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "scheme": "terraalert"
  }
}
